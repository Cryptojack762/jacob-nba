//@version=5
// S66 - Daily RSI(5) momentum (from r/algotrading). Tested by Claude 11/18/2026 on 20 coins, BloFin daily, Aug 2023 - Nov 2026:
// out-of-sample profit factor 1.47 (430 trades), every year positive. Use on the DAILY chart.
strategy("S66 Daily RSI5 > 70 momentum", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.08, process_orders_on_close=true)

rsiLen  = input.int(5,   "RSI length")
level   = input.float(70, "RSI level")
atrMult = input.float(3,  "Safety stop (ATR x)")

r = ta.rsi(close, rsiLen)
a = ta.atr(14)

// Entry: daily close where RSI(5) crosses above 70
if ta.crossover(r, level) and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

// Safety stop 3 ATR below the entry price
if strategy.position_size > 0
    strategy.exit("Stop", "Long", stop=strategy.position_avg_price - atrMult * a[1])

// Exit: daily close with RSI(5) back under 70
if strategy.position_size > 0 and r < level
    strategy.close("Long", comment="RSI back under 70")

plotshape(ta.crossover(r, level), "Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
