//@version=5
// S65 - EMA20 crosses above EMA50 while price is above EMA200. Tested by Claude 11/18/2026 on 20 coins, BloFin 4H, Aug 2023 - Nov 2026:
// out-of-sample profit factor 1.87 (298 trades), every year positive. Use on the 4H chart.
strategy("S65 4H EMA20 x EMA50 above EMA200", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.08, process_orders_on_close=true)

fastLen = input.int(20,  "Fast EMA")
slowLen = input.int(50,  "Slow EMA")
trendLen= input.int(200, "Trend EMA")
atrMult = input.float(2, "Stop (ATR x)")

e20  = ta.ema(close, fastLen)
e50  = ta.ema(close, slowLen)
e200 = ta.ema(close, trendLen)
a    = ta.atr(14)

// Entry: 4H close where EMA20 crosses above EMA50, and price is above EMA200
longSignal = ta.crossover(e20, e50) and close > e200
var int entryBar = na
if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    entryBar := bar_index

// Stop 2 ATR below the entry price
if strategy.position_size > 0
    strategy.exit("Stop", "Long", stop=strategy.position_avg_price - atrMult * a[1])

// Exit: 4H close under EMA20 (after at least 2 candles), or after 60 candles
if strategy.position_size > 0 and ((bar_index - entryBar >= 2 and close < e20) or bar_index - entryBar >= 60)
    strategy.close("Long", comment="Close under EMA20")

plot(e20,  "EMA20",  color.yellow)
plot(e50,  "EMA50",  color.orange)
plot(e200, "EMA200", color.red, 2)
plotshape(longSignal, "Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
